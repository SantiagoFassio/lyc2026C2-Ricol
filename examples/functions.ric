func add(a: Int, b: Int) -> Int {
    return a + b;
}

print "2 + 3 = ";
print add(2, 3);
print "\n";

func greet(name: String) {
    print "hello, " + name + "\n";
}

greet("Ricol");

func factorial(n: Int) -> Int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

print "10! = ";
print factorial(10);
print "\n";

@ Consecutive functions can call each other
func isEven(n: Int) -> Bool {
    if (n == 0) {
        return True;
    }
    return isOdd(n - 1);
}
func isOdd(n: Int) -> Bool {
    if (n == 0) {
        return False;
    }
    return isEven(n - 1);
}

print "7 is even: ";
print isEven(7);
print "\n";

func squareRoot(n: Int) -> Int {
    let i: Int = 0;
    while (True) {
        if (i * i >= n) {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

print "integer square root of 50: ";
print squareRoot(50);
print "\n";

func printUntil(limit: Int) {
    let i: Int = 1;
    while (True) {
        if (i > limit) {
            return;
        }
        print i;
        print " ";
        i = i + 1;
    }
}

printUntil(5);
print "\n";

let total: Int = 0;
func deposit(amount: Int) {
    total = total + amount;
}

deposit(100);
deposit(50);
print "total after two deposits: ";
print total;
print "\n";

func sumUpTo(n: Int) -> Int {
    let sum: Int = 0;
    func addToSum(x: Int) {
        sum = sum + x;
    }
    let i: Int = 1;
    while (i <= n) {
        addToSum(i);
        i = i + 1;
    }
    return sum;
}

print "sum up to 100: ";
print sumUpTo(100);
print "\n";

let scope: String = "global";
{
    func whichScope() -> String {
        return scope;
    }
    let scope: String = "block";
    print "the function sees the ";
    print whichScope();
    print " variable, not the ";
    print scope;
    print " one\n";
}

@ The following statements are rejected by the type checker:
@ add(1);                     Function 'add' expects 2 arguments, got 1
@ add(1, 2.5);                Argument 2 of function 'add' must be Int, got Float
@ print greet("x");           Cannot print a Void value
@ let f: Int = add;           Cannot use function 'add' as a value
@ print later();              Undefined function 'later'
@ func later() -> Int {}      Function 'later' does not return a value on every path
@ return 1;                   'return' outside function
