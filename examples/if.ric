if (True) {
    print "simple if\n";
}

let a: Int = 1;
let b: Int = 2;
if (a > b) {
    print "a is greater than b\n";
} else {
    print "a is not greater than b\n";
}

let n: Int = 10;
if (n % 2 == 1) {
    print "n is odd\n";
} else if (n % 5 == 0) {
    print "n is a multiple of 5\n";
} else if (n % 2 == 0) {
    print "this will not be printed, as the code entered the previous branch\n";
} else {
    print "this will also not be printed\n";
}

let greeting: String = "hello";
let isAdmin: Bool = False;
if (greeting < "world" and not isAdmin) {
    print "compound conditions\n";
}

if (a + b == 3) {
    print "first if\n";
    if (b * 3 >= 6) {
        print "nested if\n";
    } else {
        print "this will not be printed\n";
    }
}

let grade: Float = 7.5;
let result: String = "failed";
if (grade >= 4) {
    result = "passed";
}
print "the student ";
print result;
print "\n";

let found: Bool = False;
if (found = n > 5) {
    print "an assignment can be used as a condition: ";
    print found;
    print "\n";
}

if (True) {
    let n: String = "a variable declared inside a branch";
    print n;
    print " only exists inside it\n";
}
print "outside the branch n is still ";
print n;
print "\n";
