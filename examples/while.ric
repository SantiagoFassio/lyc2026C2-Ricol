while (False) {
    print "this will not be printed, as the condition is false\n";
}

while (True) {
    print "simple while with break\n";
    break;
    print "this will not be printed, as the loop was stopped by the break\n";
}

let i: Int = 1;
while (i <= 5) {
    print i;
    print " ";
    i = i + 1;
}
print "\n";

let sum: Int = 0;
let j: Int = 0;
while (j < 10) {
    j = j + 1;
    if (j % 2 == 0) {
        continue;
    }
    sum = sum + j;
}
print "sum of the odd numbers up to 10: ";
print sum;
print "\n";

let power: Int = 1;
while (True) {
    power = power * 2;
    if (power > 100) {
        print "first power of 2 greater than 100: ";
        print power;
        print "\n";
        break;
    }
}

let running: Bool = True;
let balance: Float = 100.0;
while (running and not balance < 0) {
    balance = balance - 30.5;
    if (balance < 50) {
        running = False;
    }
}
print "final balance: ";
print balance;
print "\n";

let row: Int = 1;
while (row <= 3) {
    let column: Int = 1;
    while (True) {
        print row * column;
        print " ";
        if (column == 3) {
            break;
        }
        column = column + 1;
    }
    print "\n";
    row = row + 1;
}
print "the inner break only stops the inner while\n";

print "execution continues after the loops\n";
