func assertInt(actual: Int, expected: Int) {
    if (actual != expected) {
        print "ERROR\n";
    } else {
        print "OK\n";
    }
}

func assertString(actual: String, expected: String) {
    if (actual != expected) {
        print "ERROR\n";
    } else {
        print "OK\n";
    }
}

func assertBool(actual: Bool, expected: Bool) {
    if (actual != expected) {
        print "ERROR\n";
    } else {
        print "OK\n";
    }
}
